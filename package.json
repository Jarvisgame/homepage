{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:proxy": "cross-env NODE_USE_ENV_PROXY=1 HTTP_PROXY=http://127.0.0.1:7890 HTTPS_PROXY=http://127.0.0.1:7890 nuxt dev",
    "generate": "nuxt generate",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@notionhq/client": "^5.9.0",
    "98.css": "^0.1.21",
    "marked": "^17.0.3",
    "notion-to-md": "^3.1.9",
    "nuxt": "^4.3.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "packageManager": "npm@10.9.9",
  "devDependencies": {
    "@types/node": "^25.3.1",
    "cross-env": "^10.1.0",
    "wrangler": "^4"
  }
}
