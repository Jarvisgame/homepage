# Notion API 密钥 — 从 https://www.notion.so/my-integrations 获取
# 复制此文件为 .env 并填入真实密钥
NOTION_API_KEY=ntn_xxxxxxxxxxxx

# Notion 页面 ID — 从你的 Notion 页面 URL 中提取
# 例如 https://www.notion.so/My-Page-32e545eac54280dc897bf9da70625372
# 则 PAGE_ID = 32e545eac54280dc897bf9da70625372
NOTION_PAGE_ID=你的页面ID

# Notion 访客计数器数据库 ID — 从你的计数数据库 URL 中提取
# 在 Notion 中创建一个数据库，添加一个「数字」类型的属性（如 "Count"）
# 然后从 URL 中提取数据库 ID 填入下方
NOTION_COUNTER_DB_ID=你的计数器数据库ID
